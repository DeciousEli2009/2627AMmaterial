colorscheme pablo

"set the color"
set number
"vim sets the highlight based on your file ext"
syntax on
"highlights what row you are on
"set cursorline
"disconnects vim from vi"
set nocompatible
"vim figyres out what file"
filetype on
"indents the file based on the type"

"set cursorline"
"set cursorcolumn"
set shiftwidth=4
filetype plugin on
filetype indent on
set tabstop=3
set nowrap
set nobackup
set virtualedit+=onemore




